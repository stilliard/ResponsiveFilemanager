{
    "name": "stilliard/responsive-filemanager",
    "description": "Dev tooling for Responsive FileManager. The app itself has no runtime PHP dependencies.",
    "license": "CC-BY-NC-3.0",
    "require-dev": {
        "vimeo/psalm": "^5.0"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "psalm": "psalm --show-info=false",
        "psalm-baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm-taint": "psalm --taint-analysis"
    }
}
